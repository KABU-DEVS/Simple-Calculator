                android:layout_marginBottom="10dp"/>

            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnAdd"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="+"
                    android:textSize="26sp"
                    android:textColor="@color/operator_text"
                    android:textStyle="bold"
                    android:background="@drawable/operator_button_background"/>

                <Button
                    android:id="@+id/btnSubtract"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="−"
                    android:textSize="26sp"
                    android:textColor="@color/operator_text"
                    android:textStyle="bold"
                    android:background="@drawable/operator_button_background"/>

            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="10dp"/>

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnMultiply"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="×"
                    android:textSize="26sp"
                    android:textColor="@color/operator_text"
                    android:textStyle="bold"
                    android:background="@drawable/operator_button_background"/>

                <Button
                    android:id="@+id/btnDivide"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="÷"
                    android:textSize="26sp"
                    android:textColor="@color/operator_text"
                    android:textStyle="bold"
                    android:background="@drawable/operator_button_background"/>

            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="16dp"/>

            <!-- Clear button -->
            <Button
                android:id="@+id/btnClear"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="CLEAR"
                android:textSize="14sp"
                android:textColor="@color/clear_text"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:background="@drawable/clear_button_background"/>

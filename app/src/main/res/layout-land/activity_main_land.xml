<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:padding="16dp">

    <!-- Left Pane: Info, Inputs, and Result -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingEnd="24dp"
        android:paddingStart="8dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calculator_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.3"/>

        <View
            android:layout_width="48dp"
            android:layout_height="3dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:background="@color/accent_blue"/>

        <!-- Inputs Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/etNumber1"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/input_background"
                android:hint="@string/enter_first_number"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp"
                android:inputType="numberDecimal|numberSigned"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp"/>

            <EditText
                android:id="@+id/etNumber2"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/input_background"
                android:hint="@string/enter_second_number"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp"
                android:inputType="numberDecimal|numberSigned"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical"/>
        </LinearLayout>

        <!-- Result Display -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/result_background"
            android:padding="18dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/result_label"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:letterSpacing="0.2"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/tvResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/result_placeholder"
                android:textColor="@color/text_result"
                android:textSize="32sp"
                android:textStyle="bold"
                android:gravity="center"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Right Pane: Ergonomic Numeric Keypad -->
    <LinearLayout
        android:id="@+id/keyboardContainer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:orientation="vertical">

        <!-- Keyboard Rows using Weights to fill height -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <Button android:id="@+id/key7" style="@style/KeyboardKey" android:text="7" />
            <Button android:id="@+id/key8" style="@style/KeyboardKey" android:text="8" />
            <Button android:id="@+id/key9" style="@style/KeyboardKey" android:text="9" />
            <Button android:id="@+id/keyDivide" style="@style/KeyboardKey.Operator" android:text="÷" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <Button android:id="@+id/key4" style="@style/KeyboardKey" android:text="4" />
            <Button android:id="@+id/key5" style="@style/KeyboardKey" android:text="5" />
            <Button android:id="@+id/key6" style="@style/KeyboardKey" android:text="6" />
            <Button android:id="@+id/keyMultiply" style="@style/KeyboardKey.Operator" android:text="×" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <Button android:id="@+id/key1" style="@style/KeyboardKey" android:text="1" />
            <Button android:id="@+id/key2" style="@style/KeyboardKey" android:text="2" />
            <Button android:id="@+id/key3" style="@style/KeyboardKey" android:text="3" />
            <Button android:id="@+id/keySubtract" style="@style/KeyboardKey.Operator" android:text="−" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <Button android:id="@+id/key0" style="@style/KeyboardKey" android:text="0" />
            <Button android:id="@+id/keyDot" style="@style/KeyboardKey" android:text="." />
            <Button android:id="@+id/keyBackspace" style="@style/KeyboardKey" android:text="⌫" />
            <Button android:id="@+id/keyAdd" style="@style/KeyboardKey.Operator" android:text="+" />
        </LinearLayout>

        <!-- Bottom Action Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <Button android:id="@+id/keyAC" style="@style/KeyboardKey.Action" android:text="@string/btn_ac" android:layout_marginEnd="4dp" />
            <Button android:id="@+id/keyCalculate" style="@style/KeyboardKey.Action" android:text="@string/calculate_total" android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

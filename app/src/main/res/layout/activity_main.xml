<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ══════════════════════════════ -->
        <!--            HEADER             -->
        <!-- ══════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CALCULATOR"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.3"/>

            <View
                android:layout_width="40dp"
                android:layout_height="3dp"
                android:layout_marginTop="6dp"
                android:background="@color/accent_blue"/>

        </LinearLayout>

        <!-- ══════════════════════════════ -->
        <!--          INPUT CARD           -->
        <!-- ══════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="20dp"
            android:elevation="4dp">

            <!-- Label: First Number -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="First Number"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="6dp"/>

            <!-- EditText: Number 1 -->
            <EditText
                android:id="@+id/etNumber1"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/input_background"
                android:hint="Enter first number"
                android:hintTextColor="@color/text_hint"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:inputType="numberDecimal|numberSigned"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center_vertical"
                android:textCursorDrawable="@null"/>

            <!-- Spacer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="16dp"/>

            <!-- Label: Second Number -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Second Number"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="6dp"/>

            <!-- EditText: Number 2 -->
            <EditText
                android:id="@+id/etNumber2"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/input_background"
                android:hint="Enter second number"
                android:hintTextColor="@color/text_hint"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:inputType="numberDecimal|numberSigned"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center_vertical"
                android:textCursorDrawable="@null"/>

        </LinearLayout>

        <!-- Spacer -->
        <View android:layout_width="match_parent" android:layout_height="20dp"/>

        <!-- ══════════════════════════════ -->
        <!--       OPERATION BUTTONS       -->
        <!-- ══════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Operation"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="10dp"/>

        <!-- Row 1: Add and Subtract -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Add Button -->
            <Button
                android:id="@+id/btnAdd"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="+"
                android:textSize="28sp"
                android:textColor="@color/operator_text"
                android:textStyle="bold"
                android:background="@drawable/operator_button_background"
                android:elevation="2dp"/>

            <!-- Subtract Button -->
            <Button
                android:id="@+id/btnSubtract"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="−"
                android:textSize="28sp"
                android:textColor="@color/operator_text"
                android:textStyle="bold"
                android:background="@drawable/operator_button_background"
                android:elevation="2dp"/>

        </LinearLayout>

        <!-- Spacer -->
        <View android:layout_width="match_parent" android:layout_height="12dp"/>

        <!-- Row 2: Multiply and Divide -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Multiply Button -->
            <Button
                android:id="@+id/btnMultiply"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="×"
                android:textSize="28sp"
                android:textColor="@color/operator_text"
                android:textStyle="bold"
                android:background="@drawable/operator_button_background"
                android:elevation="2dp"/>

            <!-- Divide Button -->
            <Button
                android:id="@+id/btnDivide"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="÷"
                android:textSize="28sp"
                android:textColor="@color/operator_text"
                android:textStyle="bold"
                android:background="@drawable/operator_button_background"
                android:elevation="2dp"/>

        </LinearLayout>

        <!-- Spacer -->
        <View android:layout_width="match_parent" android:layout_height="20dp"/>

        <!-- ══════════════════════════════ -->
        <!--          RESULT AREA          -->
        <!-- ══════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/result_background"
            android:padding="20dp"
            android:gravity="center"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RESULT"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.2"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/text_result"
                android:textSize="36sp"
                android:textStyle="bold"
                android:gravity="center"/>

        </LinearLayout>

        <!-- Spacer -->
        <View android:layout_width="match_parent" android:layout_height="20dp"/>

        <!-- ══════════════════════════════ -->
        <!--          CLEAR BUTTON         -->
        <!-- ══════════════════════════════ -->
        <Button
            android:id="@+id/btnClear"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="CLEAR"
            android:textSize="14sp"
            android:textColor="@color/clear_text"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:background="@drawable/clear_button_background"
            android:elevation="2dp"/>

        <!-- Bottom padding -->
        <View android:layout_width="match_parent" android:layout_height="24dp"/>

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================
    FILE: res/layout/activity_main.xml  (PORTRAIT)
    ROLE: UI Designer
    DESC: Main calculator layout — input cards, result display,
          operation buttons, and on-screen numpad.
          Logic Developer: wire all button IDs in MainActivity.
    ============================================================
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="14dp">

    <!-- TOP ROW: First Number Card + Result Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.4"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <!-- First Number Input Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_card_input"
            android:padding="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="# FIRST NUMBER"
                android:textColor="@color/accent_blue"
                android:textSize="9sp"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/editTextFirstNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="0"
                android:hintTextColor="@color/text_hint"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold"
                android:background="@android:color/transparent"
                android:inputType="numberDecimal|numberSigned"
                android:maxLines="1"
                android:showSoftInputOnFocus="false"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:cursorVisible="true"/>
        </LinearLayout>

        <!-- Current Result Display Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_card_result"
            android:padding="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CURRENT RESULT"
                android:textColor="@color/text_hint"
                android:textSize="9sp"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/textViewResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>

    <!-- SECOND NUMBER INPUT CARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_card_input"
        android:padding="12dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="# SECOND NUMBER"
            android:textColor="@color/accent_red"
            android:textSize="9sp"
            android:letterSpacing="0.12"
            android:textAllCaps="true"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/editTextSecondNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="0"
            android:hintTextColor="@color/text_hint"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:background="@android:color/transparent"
            android:inputType="numberDecimal|numberSigned"
            android:maxLines="1"
            android:showSoftInputOnFocus="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:cursorVisible="true"/>
    </LinearLayout>

    <!-- CALCULATE + CLEAR ROW -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.9"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/buttonCalculate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Calculate Total"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_calculate"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/buttonClear"
            android:layout_width="54dp"
            android:layout_height="match_parent"
            android:text="&#128465;"
            android:textSize="18sp"
            android:background="@drawable/bg_btn_clear"/>
    </LinearLayout>

    <!-- FOUR ARITHMETIC OPERATION BUTTONS -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.8"
        android:columnCount="2"
        android:rowCount="2"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/buttonAdd"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="+"
            android:textColor="@color/text_secondary"
            android:textSize="26sp"
            android:background="@drawable/bg_btn_operator"
            android:layout_margin="4dp"/>

        <Button
            android:id="@+id/buttonSubtract"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="&#8722;"
            android:textColor="@color/text_secondary"
            android:textSize="26sp"
            android:background="@drawable/bg_btn_operator"
            android:layout_margin="4dp"/>

        <Button
            android:id="@+id/buttonMultiply"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="&#215;"
            android:textColor="@color/text_secondary"
            android:textSize="26sp"
            android:background="@drawable/bg_btn_operator"
            android:layout_margin="4dp"/>

        <Button
            android:id="@+id/buttonDivide"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="&#247;"
            android:textColor="@color/text_secondary"
            android:textSize="26sp"
            android:background="@drawable/bg_btn_operator"
            android:layout_margin="4dp"/>
    </GridLayout>

    <!--
        ═══════════════════════════════════════════════
        ON-SCREEN NUMPAD
        Logic Developer note:
          - btn_0 to btn_9 → append digit to focused EditText
          - btn_dot        → append "." if not already present
          - btn_back       → delete last character from focused EditText
          - btn_pad_add / btn_pad_subtract /
            btn_pad_multiply / btn_pad_divide → same as top buttons
        ═══════════════════════════════════════════════
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:orientation="vertical"
        android:background="@drawable/bg_numpad"
        android:padding="6dp">

        <!-- Row 1 : 7  8  9  ÷ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="5dp">
            <Button android:id="@+id/btn_7"
                style="@style/NumpadDigit"
                android:text="7" android:layout_marginEnd="5dp"/>
            <Button android:id="@+id/btn_8"
                style="@style/NumpadDigit"
                android:text="8" android:layout_marginEnd="5dp"/>
            <Button android:id="@+id/btn_9"
                style="@style/NumpadDigit"
                android:text="9" android:layout_marginEnd="5dp"/>
            <Button android:id="@+id/btn_pad_divide"
                style="@style/NumpadOperator"
                android:text="&#247;"/>
        </LinearLayout>

        <!-- Row 2 : 4  5  6  × -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="5dp">
            <Button android:id="@+id/btn_4"
                style="@style/NumpadDigit"
                android:text="4" android:layout_marginEnd="5dp"/>
            <Button android:id="@+id/btn_5"
                style="@style/NumpadDigit"
                android:text="5" android:layout_marginEnd="5dp"/>
            <Button android:id="@+id/btn_6"
                style="@style/NumpadDigit"
                android:text="6" android:layout_marginEnd="5dp"/>
            <Button android:id="@+id/btn_pad_multiply"
                style="@style/NumpadOperator"
                android:text="&#215;"/>
        </LinearLayout>

        <!-- Row 3 : 1  2  3  − -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="5dp">
            <Button android:id="@+id/btn_1"
                style="@style/NumpadDigit"
                android:text="1" android:layout_marginEnd="5dp"/>
            <Button android:id="@+id/btn_2"
                style="@style/NumpadDigit"
                android:text="2" android:layout_marginEnd="5dp"/>
            <Button android:id="@+id/btn_3"
                style="@style/NumpadDigit"
                android:text="3" android:layout_marginEnd="5dp"/>
            <Button android:id="@+id/btn_pad_subtract"
                style="@style/NumpadOperator"
                android:text="&#8722;"/>
        </LinearLayout>

        <!-- Row 4 : 0  .  ⌫  + -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <Button android:id="@+id/btn_0"
                style="@style/NumpadDigit"
                android:text="0" android:layout_marginEnd="5dp"/>
            <Button android:id="@+id/btn_dot"
                style="@style/NumpadDigit"
                android:text="." android:layout_marginEnd="5dp"/>
            <Button android:id="@+id/btn_back"
                style="@style/NumpadDigit"
                android:text="&#9003;" android:layout_marginEnd="5dp"/>
            <Button android:id="@+id/btn_pad_add"
                style="@style/NumpadOperator"
                android:text="+"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>

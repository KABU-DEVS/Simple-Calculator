<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CALCULATOR"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.3"/>

            <View
                android:layout_width="48dp"
                android:layout_height="3dp"
                android:layout_marginTop="8dp"
                android:background="@color/accent_blue"/>

        </LinearLayout>

        <!-- Input Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="First Number"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etNumber1"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/input_background"
                android:hint="Enter first number"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="18sp"
                android:inputType="numberDecimal|numberSigned"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center_vertical"/>

            <View android:layout_width="match_parent" android:layout_height="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Second Number"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etNumber2"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/input_background"
                android:hint="Enter second number"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="18sp"
                android:inputType="numberDecimal|numberSigned"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center_vertical"/>

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="20dp"/>

        <!-- Select Operation label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Operation"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="12dp"/>

        <!-- Operator buttons row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnAdd"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="+"
                android:textSize="30sp"
                android:textColor="@color/operator_text"
                android:textStyle="bold"
                android:background="@drawable/operator_button_background"
                android:elevation="2dp"/>

            <Button
                android:id="@+id/btnSubtract"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="−"
                android:textSize="30sp"
                android:textColor="@color/operator_text"
                android:textStyle="bold"
                android:background="@drawable/operator_button_background"
                android:elevation="2dp"/>

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="12dp"/>

        <!-- Operator buttons row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnMultiply"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="×"
                android:textSize="30sp"
                android:textColor="@color/operator_text"
                android:textStyle="bold"
                android:background="@drawable/operator_button_background"
                android:elevation="2dp"/>

            <Button
                android:id="@+id/btnDivide"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="÷"
                android:textSize="30sp"
                android:textColor="@color/operator_text"
                android:textStyle="bold"
                android:background="@drawable/operator_button_background"
                android:elevation="2dp"/>

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="20dp"/>

        <!-- Result area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/result_background"
            android:padding="24dp"
            android:gravity="center"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RESULT"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:letterSpacing="0.2"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/tvResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/text_result"
                android:textSize="36sp"
                android:textStyle="bold"
                android:gravity="center"/>

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="20dp"/>

        <!-- Clear button -->
        <Button
            android:id="@+id/btnClear"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="CLEAR"
            android:textSize="15sp"
            android:textColor="@color/clear_text"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:background="@drawable/clear_button_background"
            android:elevation="2dp"/>

        <View android:layout_width="match_parent" android:layout_height="32dp"/>

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/keyboardContainer"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="24dp"
                android:paddingBottom="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/calculator_title"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.3"/>

                <View
                    android:layout_width="48dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/accent_blue"/>

            </LinearLayout>

            <!-- Input Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/first_number"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etNumber1"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/input_background"
                    android:hint="@string/enter_first_number"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="18sp"
                    android:inputType="none"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center_vertical"/>

                <View android:layout_width="match_parent" android:layout_height="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/second_number"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etNumber2"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/input_background"
                    android:hint="@string/enter_second_number"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="18sp"
                    android:inputType="none"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center_vertical"/>

            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="20dp"/>

            <!-- Result area -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/result_background"
                android:padding="24dp"
                android:gravity="center"
                android:elevation="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/result_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:letterSpacing="0.2"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:id="@+id/tvResult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/result_placeholder"
                    android:textColor="@color/text_result"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:gravity="center"/>

            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="32dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Custom Keyboard Component -->
    <LinearLayout
        android:id="@+id/keyboardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#1A000000"> <!-- Semi-transparent background for the keyboard area -->

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <Button android:id="@+id/key7" style="@style/KeyboardKey" android:text="7" />
            <Button android:id="@+id/key8" style="@style/KeyboardKey" android:text="8" />
            <Button android:id="@+id/key9" style="@style/KeyboardKey" android:text="9" />
            <Button android:id="@+id/keyDivide" style="@style/KeyboardKey.Operator" android:text="÷" />
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <Button android:id="@+id/key4" style="@style/KeyboardKey" android:text="4" />
            <Button android:id="@+id/key5" style="@style/KeyboardKey" android:text="5" />
            <Button android:id="@+id/key6" style="@style/KeyboardKey" android:text="6" />
            <Button android:id="@+id/keyMultiply" style="@style/KeyboardKey.Operator" android:text="×" />
        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <Button android:id="@+id/key1" style="@style/KeyboardKey" android:text="1" />
            <Button android:id="@+id/key2" style="@style/KeyboardKey" android:text="2" />
            <Button android:id="@+id/key3" style="@style/KeyboardKey" android:text="3" />
            <Button android:id="@+id/keySubtract" style="@style/KeyboardKey.Operator" android:text="−" />
        </LinearLayout>

        <!-- Row 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal">
            <Button android:id="@+id/key0" style="@style/KeyboardKey" android:text="0" />
            <Button android:id="@+id/keyDot" style="@style/KeyboardKey" android:text="." />
            <Button android:id="@+id/keyBackspace" style="@style/KeyboardKey" android:text="⌫" />
            <Button android:id="@+id/keyAdd" style="@style/KeyboardKey.Operator" android:text="+" />
        </LinearLayout>

        <!-- AC and Equals -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">
            <Button android:id="@+id/keyAC" style="@style/KeyboardKey.Action" android:text="AC" android:layout_marginEnd="4dp"/>
            <Button android:id="@+id/keyCalculate" style="@style/KeyboardKey.Action" android:text="@string/calculate_total" android:layout_marginStart="4dp"/>
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>

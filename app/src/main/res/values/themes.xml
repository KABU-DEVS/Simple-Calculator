<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SimpleCalculator" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/display_bg</item>
    </style>

    <style name="Theme.SimpleCalculator" parent="Base.Theme.SimpleCalculator" />

    <!-- Custom Keyboard Styles -->
    <style name="KeyboardKey" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/keyboard_key_background</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="KeyboardKey.Operator">
        <item name="android:textColor">@color/accent_blue</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="KeyboardKey.Action">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">16sp</item>
        <item name="android:backgroundTint">@color/accent_blue</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <!-- Calculator Button Styles (Legacy) -->
    <style name="CalcButton" parent="Widget.Material3.Button.UnelevatedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="CalcButton.Numeric">
        <item name="android:backgroundTint">@color/btn_numeric</item>
    </style>

    <style name="CalcButton.Operator">
        <item name="android:backgroundTint">@color/btn_operator</item>
    </style>

    <style name="CalcButton.AC">
        <item name="android:backgroundTint">@color/btn_ac</item>
    </style>

    <style name="CalcButton.Equals">
        <item name="android:backgroundTint">@color/btn_equals</item>
    </style>

    <style name="CalcButton.Scientific">
        <item name="android:backgroundTint">@color/bg_main</item>
        <item name="android:textColor">@color/text_grey</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>